global
    tune.ssl.default-dh-param 2048
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon
    h1-case-adjust x-served-by X-Served-By
    h1-case-adjust server Server
    h1-case-adjust content-type Content-Type
    h1-case-adjust content-length Content-Length

defaults
    log global
    mode http
    option h1-case-adjust-bogus-client
    option httplog
    option dontlognull
    timeout connect 5000
    timeout client 50000
    timeout server 50000

frontend http-in
    bind *:80
    mode http
    redirect scheme https code 301 if !{ ssl_fc }

frontend https-in
    bind *:443 ssl crt /etc/haproxy/certs/www.yannissheja.tech.pem
    mode http
    http-request set-header X-Forwarded-Proto https
    default_backend web-servers

backend web-servers
    mode http
    balance roundrobin
    server 7402-web-01 18.170.217.131:80 check
    server 7402-web-02 18.132.98.220:80 check
